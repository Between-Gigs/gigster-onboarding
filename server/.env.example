PORT=8787
# Local development default. For a container use HOST=0.0.0.0.
HOST=127.0.0.1
DATABASE_PATH=./data/onboarding.sqlite
# The existing app's PUBLIC Clerk key. No Clerk secret key is required.
CLERK_PUBLISHABLE_KEY=
# Exact origins; no URL paths, no wildcard, comma separated.
FRONTEND_ORIGINS=http://localhost:5173,https://between-gigs.github.io
# Generate a random secret with at least 32 bytes. Keep it stable so old links continue working.
UNSUBSCRIBE_SECRET=
# Clerk user IDs allowed to read the private review queue. Empty means no reviewer access.
REVIEWER_CLERK_IDS=
